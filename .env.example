# Copy this file to backend/.env and fill in your keys. NEVER commit the real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 to skip the AI and return a clearly-labelled sample result (for testing without a key)
MOCK_AI=1
# Where the frontend is served from; used inside the passport QR code
PUBLIC_BASE_URL=http://localhost:5500
